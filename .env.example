# Supabase (public — safe to expose to the browser; RLS controls access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — Phase 4 only. Used exclusively by the Telegram
# webhook backend (src/app/api/telegram/webhook/route.ts and the
# lib/telegram/* modules it calls), which has no browser session to
# authenticate with. NEVER prefix this with NEXT_PUBLIC_ and never
# import it from a Client Component. Find it in Project Settings → API
# → service_role (keep it secret — do not use the anon key here).
SUPABASE_SERVICE_ROLE_KEY=

# Telegram (Phase 4)
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Any random string (e.g. `openssl rand -hex 32`) — passed to Telegram's
# setWebhook as secret_token; the webhook route checks every incoming
# request's X-Telegram-Bot-Api-Secret-Token header against this.
TELEGRAM_WEBHOOK_SECRET=
# Public — used to build the t.me deep link from the dashboard's
# "Connect Telegram" button. No leading @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Used for SEO metadata (canonical URLs, sitemap.xml, robots.txt, Open
# Graph tags) via src/lib/constants.ts. Set this to your real domain
# once you have one, e.g. https://northlinecargo.com — no trailing
# slash. Safe to be public; it's just a URL, not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
