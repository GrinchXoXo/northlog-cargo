# Supabase (public, safe to expose to the browser; RLS controls access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses RLS, so it must never be used as a way
# around the organization boundary (src/lib/supabase/service.ts). Used
# server-side by exactly one flow: creating/looking up the Supabase
# Auth user when the platform operator provisions a new organization
# (src/lib/organizations/provision.ts). NEVER prefix this with
# NEXT_PUBLIC_ and never import it from a Client Component. Find it in
# Project Settings, API, service_role (keep it secret, do not use the
# anon key here).
SUPABASE_SERVICE_ROLE_KEY=

# Used for SEO metadata (canonical URLs, sitemap.xml, robots.txt, Open
# Graph tags) via src/lib/constants.ts. NEXT_PUBLIC_* variables are
# baked into the build at build time, not read at runtime, so for a
# real production deploy put the real value in .env.production.local
# instead of changing this file. That way local dev (npm run dev) keeps
# using localhost while `npm run deploy` picks up the real domain
# automatically. See README for the full deploy sequence.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
